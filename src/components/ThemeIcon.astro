---

---

<button id="themeToggle">
    <span class="theme-text">THEME</span>
</button>

<style>
    #themeToggle {
        position: fixed;
        top: 1rem;
        right: 1rem;
        padding: 0.3rem;
        border: 0;
        background: transparent;
        z-index: 100;
        cursor: pointer;
    }

    .theme-text {
        font-family: monospace;
        font-size: 0.7rem;
        font-weight: bold;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-color);
        opacity: 0.8;
        transition: opacity 0.3s;
    }

    #themeToggle:hover .theme-text {
        opacity: 1;
    }

    @media (max-width: 768px) {
        #themeToggle {
            top: 0.7rem;
            right: 0.7rem;
        }

        .theme-text {
            font-size: 0.6rem;
        }
    }
</style>

<script>
    function handleToggleClick() {
        const el = document.documentElement;
        const isDark = el.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
        try { document.dispatchEvent(new CustomEvent("themechange", { detail: { theme: isDark ? "dark" : "light" } })); } catch {}
    }

    function initThemeToggle() {
        const btn = document.getElementById("themeToggle");
        if (btn) btn.onclick = handleToggleClick;
    }

    // Bind on initial load and after client-router swaps
    document.addEventListener("DOMContentLoaded", initThemeToggle, { once: true });
    document.addEventListener("astro:page-load", initThemeToggle, { once: true });
</script>
